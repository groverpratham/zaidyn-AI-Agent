# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real AWS keys.

# --- AWS / S3 (required) ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Prefix (folder) inside S3_BUCKET_NAME where generated configs are uploaded.
S3_UPLOAD_PREFIX=ZDH_AI_AGENT

# --- Downstream app (fill in later, once you have the API spec) ---
DOWNSTREAM_API_URL=
DOWNSTREAM_API_KEY=
